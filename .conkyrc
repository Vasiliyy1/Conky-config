-- Conky, a system monitor https://github.com/brndnmtthws/conky
--
-- This configuration file is Lua code. You can write code in here, and it will
-- execute when Conky loads. You can use it to generate your own advanced
-- configurations.
--
-- Try this (remove the `--`):
--
print("Loading Conky config")
--
-- For more on Lua, see:
-- https://www.lua.org/pil/contents.html
--
-- Conky Lua API: https://conky.cc/lua
-- Configuration settings: https://conky.cc/config_settings

conky.config = {
    alignment = 'top_right',
    background = true,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = 'FF653D',
    default_outline_color = 'orange',
    default_shade_color = 'orange',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    extra_newline = false,
    font = 'Adwaita Mono:size=12',
    gap_x = 20,
    gap_y = 50,
    minimum_height = 600,
    minimum_width = 100,
    net_avg_samples = 0.25,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_wayland = false,
    out_to_x = true,
    own_window= true,
    own_window_type= 'desktop',
    own_window_transparent= true,
    own_window_hints= 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_colour= '000000',
    own_window_argb_visual= true,
    show_graph_range = false,
    show_graph_scale = false,
    stippled_borders = 0,
    update_interval = 1.0,
    uppercase = false,
    use_spacer = 'none',
    use_xft = true,

    color1 = 'D9D9D9',
    color2 = 'ff7373'
}

-- Variables: https://conky.cc/variables

conky.text = [[
$color1${voffset 10}${font Michroma:style=Bold}SYSTEM $color ${hr 2}
${alignc}${voffset 10}$font $color1 Uptime: $color ${font Tomorrow:style=Bold Italic} $uptime
${alignc}${voffset 10}$color1 ${font Michroma}RAM $color${hr 2}
${alignc}${voffset 10}$color $font $mem / $memmax 
${voffset 8}${font Tomorrow:style=bold}$memperc% ${membar 10}
${alignc}${voffset 10}$color1 ${font Michroma}Swap $color${hr 2}
${voffset 8}$color$font $swap / $swapmax - ${font Tomorrow:style=bold} $swapperc% ${swapbar 10}
${alignc}${voffset 10}$color1 ${font Michroma} CPU $color${hr 2}
${voffset 10}${color1}Temp CPU:${alignr}${font Tomorrow:style=bold:size=13} ${exec sensors | grep "Tctl" | tr -d 'Tctl: +'}
${voffset 10}$color1${font Michroma}Temp GPU:${alignr}${font Tomorrow:style=bold:size=13} ${exec sensors | grep 'temp1' | cut -c16-22}
${voffset 10}$color${font Tomorrow:style=bold} $cpu% ${cpubar 10}
${alignc}${voffset 10}${color1}${font}Processes:$color $processes  ${color1}Running:$color $running_processes
$color1${voffset 10}${font Michroma:style=Bold}NETWORK $color ${hr 2}
${voffset 10}${alignc}$font $color1 Up:$color ${upspeed enp5s0} ${color1}Down:$color ${downspeed enp5s0}
]]
